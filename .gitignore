# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.pem

# --- dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js build output ---
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# --- Vercel ---
.vercel

# --- local databases ---
*.db
*.sqlite

# --- test, audit and report output ---
/coverage
/test-results/
/playwright-report/
test-output.txt
quality-output.txt
seo-report.txt
lighthouse*.json
lighthouse*.html
.lighthouseci/

# --- private source documents (CV with CGPA, phone, address) ---
/private/
cv_claims_review.md
/*CV*.pdf
/*cv*.pdf

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS and editor files ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- temp ---
/tmp/
/scratch/
*.tmp
.gemini/
